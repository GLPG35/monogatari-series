---
import type { GetStaticPaths } from "astro"
import Layout from '../../layouts/Layout.astro'
import './arc.scss'
import arcs from '../../utils/arcs.json'
import GalleryContainer from '../../components/GalleryContainer'

export const getStaticPaths = (() => {
	return [
		{ params: { arc: 'bakemonogatari' }},
		{ params: { arc: 'kizumonogatari-I' }},
		{ params: { arc: 'kizumonogatari-II' }},
		{ params: { arc: 'kizumonogatari-III' }},
		{ params: { arc: 'kizumonogatari-koyomi-vamp' }},
		{ params: { arc: 'nisemonogatari' }},
		{ params: { arc: 'nekomonogatari-kuro' }},
		{ params: { arc: 'nekomonogatari-shiro' }},
		{ params: { arc: 'kabukimonogatari' }},
		{ params: { arc: 'hanamonogatari' }},
		{ params: { arc: 'otorimonogatari' }},
		{ params: { arc: 'onimonogatari' }},
		{ params: { arc: 'koimonogatari' }},
		{ params: { arc: 'tsukimonogatari' }},
		{ params: { arc: 'koyomimonogatari' }},
		{ params: { arc: 'owarimonogatari-jou' }},
		{ params: { arc: 'owarimonogatari-ge' }},
		{ params: { arc: 'zoku-owarimonogatari' }},
		{ params: { arc: 'orokamonogatari' }},
		{ params: { arc: 'nademonogatari' }},
		{ params: { arc: 'wazamonogatari-ova' }},
		{ params: { arc: 'wazamonogatari' }},
		{ params: { arc: 'shinobumonogatari' }},
	]
}) satisfies GetStaticPaths

const { arc } = Astro.params
const findArcIndex = arcs.findIndex(x => x.name === arc)

if (findArcIndex === -1) return Astro.redirect('/404')

const { color, pictures, name, title, kanji, info, responsivePosition } = arcs[findArcIndex]
const prevArc = findArcIndex === 0 || arcs[findArcIndex].hidden ? null : arcs[findArcIndex - (arcs[findArcIndex - 1].hidden ? 2 : 1)]
const nextArc = findArcIndex === arcs.length - 1 || arcs[findArcIndex].hidden ? null : arcs[findArcIndex + (arcs[findArcIndex + 1].hidden ? 2 : 1)]
const gallery = info.gallery as [string[], "visible"|"hidden"][]
const arcsText = info.arcs.length > 1 ? `${info.arcs.slice(0, info.arcs.length - 1).join(', ')} and ${info.arcs[info.arcs.length - 1]}` : info.arcs.join(', ')
---

<html lang="en" style={`--bg-color: var(${color}); --position: ${responsivePosition}`}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="〈物語〉" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Monogatari Series - {name}</title>
		<meta name="description" content="Here you'll find information about the Monogatari Series light novels, the anime adaptation and more!" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`〈物語〉Monogatari Series - ${title}`} />
		<meta property="og:description" content="Here you'll find information about the Monogatari Series light novels, the anime adaptation and more!" />
		<meta property="og:url" content="https://monogatariseri.es/" />
		<meta property="og:image" content={`https://monogatari-series.vercel.app/banners/${name}.jpg`} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://monogatariseri.es/" />
		<meta property="twitter:title" content={`〈物語〉Monogatari Series - ${title}`} />
		<meta property="twitter:description" content="Here you'll find information about the Monogatari Series light novels, the anime adaptation and more!" />
		<meta property="twitter:image" content={`https://monogatari-series.vercel.app/banners/${name}.jpg`} />
	</head>
	<body>
		<Layout>
			<main>
				<div class="summary">
					<div class="cover">
						<a href={pictures[2]} target="_blank">Full resolution</a>
						<picture>
							{pictures.map((path, i) => {
								const isLast = pictures.length === i + 1
								const type = path.split('.').pop()

								if (isLast) return <img src={path} alt="">
								
								return <source srcset={path} type={`image/${type}`}>
							})}
						</picture>
					</div>
					<div class="info">
						<div class="subtitle">
							{kanji.map(x => x[0]).join('')}
						</div>
						<div class="title">
							<h3>{title}</h3>
						</div>
						<div class="date">
							{info.date}
						</div>
						<div class="relations">
							<h4>Relations</h4>
							<div class="covers">
								{prevArc &&
									<a class="relation" href={`/anime/${prevArc.name}`}>
										<div class="when">
											<div class="whenWrapper">
												<div class="texture">
													<picture>
														<img src="/99.png" alt="">
													</picture>
													<picture class="duplicate">
														<img src="/99.png" alt="">
													</picture>
												</div>
												<span>Previous</span>
											</div>
										</div>
										<div class="cover">
											<picture>
												{(prevArc.picturesHalf ? prevArc.picturesHalf : prevArc.pictures).map((path, i) => {
													const isLast = (prevArc.picturesHalf ? prevArc.picturesHalf : prevArc.pictures).length === i + 1
													const type = path.split('.').pop()

													if (isLast) return <img src={path} alt="">
													
													return <source srcset={path} type={`image/${type}`}>
												})}
											</picture>
										</div>		
									</a>
								}
								{nextArc &&
									<a class="relation" href={`/anime/${nextArc.name}`}>
										<div class="when">
											<div class="whenWrapper">
												<div class="texture">
													<picture>
														<img src="/85.png" alt="">
													</picture>
													<picture class="duplicate">
														<img src="/85.png" alt="">
													</picture>
												</div>
												<span>Next</span>
											</div>
										</div>
										<div class="cover">
											<picture>
												{(nextArc.picturesHalf ? nextArc.picturesHalf : nextArc.pictures).map((path, i) => {
													const isLast = (nextArc.picturesHalf ? nextArc.picturesHalf : nextArc.pictures).length === i + 1
													const type = path.split('.').pop()

													if (isLast) return <img src={path} alt="">
													
													return <source srcset={path} type={`image/${type}`}>
												})}
											</picture>
										</div>		
									</a>
								}
								{info.alternatives && info.alternatives.map(alternative => (
									<a class="relation" href={`/anime/${alternative.name}`}>
										<div class="when">
											<div class="whenWrapper">
												<div class="texture">
													<picture>
														<source srcset="/12.avif" type="image/avif" />
														<source srcset="/12.webp" type="image/webp" />
														<img src="/12.png" alt="" />
													</picture>
													<picture class="duplicate">
														<source srcset="/12.avif" type="image/avif" />
														<source srcset="/12.webp" type="image/webp" />
														<img src="/12.png" alt="" />
													</picture>
												</div>
												<span>{alternative.text}</span>
											</div>
										</div>
										<div class="cover">
											<picture>
												{(alternative.picturesHalf ? alternative.picturesHalf : alternative.pictures).map((path, i) => {
													const isLast = (alternative.picturesHalf ? alternative.picturesHalf : alternative.pictures).length === i + 1
													const type = path.split('.').pop()

													if (isLast) return <img src={path} alt="">
													
													return <source srcset={path} type={`image/${type}`}>
												})}
											</picture>
										</div>		
									</a>
								))}
							</div>
						</div>
						<div class="section">
							<h4>Arcs</h4>
							<p>{arcsText}</p>
						</div>
						<div class="section">
							<h4>Description</h4>
							{info.description.map(text => (<p>{text}</p>))}
						</div>
						<GalleryContainer client:load gallery={gallery} />
					</div>
				</div>
			</main>
		</Layout>
	</body>
</html>