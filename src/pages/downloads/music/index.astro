		<meta property="twitter:image" content="https://monogatariseri.es/banners/music-downloads.jpg" />
	</head>
	<body>
		<Layout>
			<main>
				<div class="section">
					<div class="cover">
						<a href="/covers/music-cover.png" target="_blank">Full resolution</a>
						<picture>
							<source srcset="/covers/music-cover-horizontal.avif" type="image/avif" media="(width < 1130px)" />
							<source srcset="/covers/music-cover-horizontal.webp" type="image/avif" media="(width < 1130px)" />
							<source srcset="/covers/music-cover-horizontal.png" type="image/png" media="(width < 1130px)" />
							<source srcset="/covers/music-cover.avif" type="image/avif" />
							<source srcset="/covers/music-cover.webp" type="image/webp" />
							<img src="/covers/music-cover.png" alt="">
						</picture>
					</div>
					<div class="info">
						<div class="subtitle">
							〈物語〉シリーズ 音楽作品
						</div>
						<div class="title">
							<h3>Monogatari Series Music Works</h3>
						</div>
						<div class="links">
							<h4>Links</h4>
							<ul>
								<li>Monogatari Series Music Collection (Bakemonogatari - Zoku Owarimonogatari) <a href="magnet:?xt=urn:btih:9b6d5838075e5f86413659f3b29608029d4f048e&dn=Monogatari%20Series%20Music%20Collection&tr=http%3A%2F%2Fnyaa.tracker.wf%3A7777%2Fannounce&tr=udp%3A%2F%2Fopen.stealth.si%3A80%2Fannounce&tr=udp%3A%2F%2Ftracker.opentrackr.org%3A1337%2Fannounce&tr=udp%3A%2F%2Fexodus.desync.com%3A6969%2Fannounce&tr=udp%3A%2F%2Ftracker.torrent.eu.org%3A451%2Fannounce" target="_blank">[Torrent (31.9GB)]</a></li>
