---
import type { GetStaticPaths } from "astro"
import Layout from '../../../layouts/Layout.astro'
import './arc.scss'
import arcs from '../../../utils/es/arcs.json'
import music from '../../../utils/music.json'
import GalleryContainer from '../../../components/GalleryContainer'
import InteractiveMiniStory from '../../../components/InteractiveMiniStory'
import { getLangFromUrl, useTranslatedPath } from "../../../i18n/utils"

export const getStaticPaths = (() => {
	return arcs.map(({ name }) => ({ params: { arc: name }}))
}) satisfies GetStaticPaths

const { arc } = Astro.params
const findArcIndex = arcs.findIndex(x => x.name === arc)

if (findArcIndex === -1) return Astro.redirect('/404')

const currentLang = getLangFromUrl(Astro.url)
const translatePath = useTranslatedPath(currentLang)

const { color, pictures, name, title, kanji, info, responsivePosition } = arcs[findArcIndex]
const prevArc = findArcIndex === 0 || arcs[findArcIndex].hidden ? null : arcs[findArcIndex - (arcs[findArcIndex - 1].hidden ? 2 : 1)]
const nextArc = findArcIndex === arcs.length - 1 || arcs[findArcIndex].hidden ? null : arcs[findArcIndex + (arcs[findArcIndex + 1].hidden ? 2 : 1)]
const gallery = info.gallery as [string[], "visible"|"hidden"][]

const isDate = info.date.includes('-')
const [fullYear, month, day] = info.date.split('-')
const parseDate = isDate ? Intl.DateTimeFormat(currentLang, { dateStyle: 'long' }).format(new Date(+fullYear, +month - 1, +day)) : info.date

const colors = [
	'--bg-purple',
    '--bg-green',
    '--bg-lilac',
    '--bg-salmon',
    '--bg-blue',
    '--bg-orange',
    '--bg-yellow',
    '--bg-red',
    '--bg-black',
    '--bg-white'
]

const anim = {
	old: {
		name: "bezier",
		duration: "0.4s",
		easing: "cubic-bezier(0.65,0.05,0.36,1)",
		direction: "reverse"
	},
	new: {
		name: "bezier",
		duration: "0.4s",
		easing: "cubic-bezier(0.65,0.05,0.36,1)"
	}
}

const customTransition = {
	forwards: anim,
	backwards: anim
}
---

<html lang="en" style={`--bg-color: var(${color}); --position: ${responsivePosition}`}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="〈物語〉" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Monogatari Series - {title}</title>
		<meta name="description" content="¡Aquí encontrarás información sobre las novelas ligeras de la Monogatari Series, la adaptación animada y más!" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`〈物語〉Monogatari Series - ${title}`} />
		<meta property="og:description" content="¡Aquí encontrarás información sobre las novelas ligeras de la Monogatari Series, la adaptación animada y más!" />
		<meta property="og:url" content="https://monogatariseri.es/" />
		<meta property="og:image" content={`https://monogatariseri.es/banners/${name}.jpg`} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content="https://monogatariseri.es/" />
		<meta property="twitter:title" content={`〈物語〉Monogatari Series - ${title}`} />
		<meta property="twitter:description" content="¡Aquí encontrarás información sobre las novelas ligeras de la Monogatari Series, la adaptación animada y más!" />
		<meta property="twitter:image" content={`https://monogatariseri.es/banners/${name}.jpg`} />
		<script is:inline>
			const spoilers = () => {
				const showSpoilers = localStorage.getItem('musicSpoilers')
				if (showSpoilers) document.documentElement.classList.add('showSpoilers')
			}

			spoilers()

			document.addEventListener('astro:after-swap', spoilers)
		</script>
	</head>
	<body>
		<Layout>
			<main>
				<div class="summary">
					<div class="cover">
						<a href={pictures[2]} target="_blank">Máxima resolución</a>
						<picture>
							<source srcset={`/banners/${name}.avif`} type="image/avif" media="(width < 1130px)" />
							<source srcset={`/banners/${name}.webp`} type="image/webp" media="(width < 1130px)" />
							<source srcset={`/banners/${name}.jpg`} type="image/jpeg" media="(width < 1130px)" />
							{pictures.map((path, i) => {
								const isLast = pictures.length === i + 1
								const type = path.split('.').pop()

								if (isLast) return <img src={path} alt="" transition:name={`anime-cover-${arc}`} transition:animate={customTransition} />

								return <source srcset={path} type={`image/${type}`} />
							})}
						</picture>
					</div>
					<div class="info">
						<div class="subtitle">
							{kanji.map(x => x[0]).join('')}
						</div>
						<div class="title">
							<h3>{title}</h3>
						</div>
						<div class="date">
							{parseDate}
						</div>
						<div class="relations">
							<h4>Relacionados</h4>
							<div class="covers">
								{prevArc &&
									<a class="relation" href={translatePath(`/anime/${prevArc.name}`)}>
										<div class="when">
											<div class="whenWrapper">
												<div class="texture">
													<picture>
														<source srcset="/99.avif" type="image/avif">
														<source srcset="/99.webp" type="image/webp">
														<img src="/99.png" alt="" />
													</picture>
													<picture class="duplicate">
														<source srcset="/99.avif" type="image/avif">
														<source srcset="/99.webp" type="image/webp">
														<img src="/99.png" alt="" />
													</picture>
												</div>
												<span>Anterior</span>
											</div>
										</div>
										<div class="cover">
											<picture>
												{(prevArc.picturesHalf ? prevArc.picturesHalf : prevArc.pictures).map((path, i) => {
													const isLast = (prevArc.picturesHalf ? prevArc.picturesHalf : prevArc.pictures).length === i + 1
													const type = path.split('.').pop()

													if (isLast) return <img src={path} alt="" />

													return <source srcset={path} type={`image/${type}`} />
												})}
											</picture>
										</div>
									</a>
								}
								{nextArc &&
									<a class="relation" href={translatePath(`/anime/${nextArc.name}`)}>
										<div class="when">
											<div class="whenWrapper">
												<div class="texture">
													<picture>
														<source srcset="/85.avif" type="image/avif">
														<source srcset="/85.webp" type="image/webp">
														<img src="/85.png" alt="" />
													</picture>
													<picture class="duplicate">
														<source srcset="/85.avif" type="image/avif">
														<source srcset="/85.webp" type="image/webp">
														<img src="/85.png" alt="" />
													</picture>
												</div>
												<span>Siguiente</span>
											</div>
										</div>
										<div class="cover">
											<picture>
												{(nextArc.picturesHalf ? nextArc.picturesHalf : nextArc.pictures).map((path, i) => {
													const isLast = (nextArc.picturesHalf ? nextArc.picturesHalf : nextArc.pictures).length === i + 1
													const type = path.split('.').pop()

													if (isLast) return <img src={path} alt="" />

													return <source srcset={path} type={`image/${type}`} />
												})}
											</picture>
										</div>
									</a>
								}
								{info.alternatives && info.alternatives.map(alternative => (
									<a class="relation" href={translatePath(alternative.name)}>
										<div class="when">
											<div class="whenWrapper">
												<div class="texture">
													<picture>
														<source srcset="/12.avif" type="image/avif" />
														<source srcset="/12.webp" type="image/webp" />
														<img src="/12.png" alt="" />
													</picture>
													<picture class="duplicate">
														<source srcset="/12.avif" type="image/avif" />
														<source srcset="/12.webp" type="image/webp" />
														<img src="/12.png" alt="" />
													</picture>
												</div>
												<span>{alternative.text}</span>
											</div>
										</div>
										<div class="cover">
											<picture>
												{(alternative.picturesHalf ? alternative.picturesHalf : alternative.pictures).map((path, i) => {
													const isLast = (alternative.picturesHalf ? alternative.picturesHalf : alternative.pictures).length === i + 1
													const type = path.split('.').pop()

													if (isLast) return <img src={path} alt="" />

													return <source srcset={path} type={`image/${type}`} />
												})}
											</picture>
										</div>
									</a>
								))}
							</div>
						</div>
						{info.shortStories &&
							<div class="relations shortStories">
								<h4>Historias cortas</h4>
								<InteractiveMiniStory {...{shortStories: info.shortStories, currentLang}} client:idle />
							</div>
						}
						{info.music &&
							<div class="relations music">
								<h4>Música</h4>
								<div class="covers">
									{info.music.map(({ name, type }) => {
										const album = music.find(x => x.title === name)
	
										if (!album) return ''
										
										const randomCover = Math.floor(Math.random() * 3) + 1
									
										return (
											<a class="relation" href={translatePath(`/music/${name}`)}>
												<div class="when">
													<div class="whenWrapper">
														<div class="texture">
															<picture>
																<source srcset="/12.avif" type="image/avif" />
																<source srcset="/12.webp" type="image/webp" />
																<img src="/12.png" alt="" />
															</picture>
															<picture class="duplicate">
																<source srcset="/12.avif" type="image/avif" />
																<source srcset="/12.webp" type="image/webp" />
																<img src="/12.png" alt="" />
															</picture>
														</div>
														<span>{type}</span>
													</div>
												</div>
												<div class="cover">
													{album.hidden &&
														<div class="overlay" style={`background-color: var(${colors[Math.floor(Math.random() * colors.length)]})`}></div>
														<picture class="spoiler">
															<source srcset={`/wrinkled${randomCover}.avif`} type='image/avif' />
															<source srcset={`/wrinkled${randomCover}.webp`} type='image/webp' />
															<img src={`/wrinkled${randomCover}.jpg`} alt="" />
														</picture>
													}
													<picture>
														{(album.coverHalf ? album.coverHalf : album.cover).map((path, i) => {
															const isLast = (album.coverHalf ? album.coverHalf : album.cover).length === i + 1
															const type = path.split('.').pop()
		
															if (isLast) return <img src={path} alt="" style={album.position ? `object-position: ${album.position};` : ''} class={album.hidden ? 'hidden' : ''} />
		
															return <source srcset={path} type={`image/${type}`} />
														})}
													</picture>
												</div>
											</a>
										)
									})}
								</div>
							</div>
						}
						<div class="section">
							<h4>Arcos</h4>
							<ul>
								{info.arcs.map(arc => <li>{arc[0]}<span>{arc[1][0]}, {arc[1][1]}</span></li>)}
							</ul>
						</div>
						<div class="section">
							<h4>Sinopsis</h4>
							{info.description.map(text => (<p>{text}</p>))}
						</div>
						{gallery && <GalleryContainer client:load {...{gallery, currentLang}} />}
					</div>
				</div>
			</main>
		</Layout>
	</body>
</html>
