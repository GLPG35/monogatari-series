---
import './styles.scss'
import Menu from '../Menu'
import LanguageSelector from '../LanguageSelector'
import { getLangFromUrl, useTranslatedPath, useTranslations, trimLocation } from '../../i18n/utils'

const currentLang = getLangFromUrl(Astro.url)
const t = useTranslations(currentLang)
const translatePath = useTranslatedPath(currentLang)

const active = Astro.url.pathname
---
<header>
	<div class="wrapper">
		<div class="rippedWrapper2">
			<div class="ripped2">
				<picture>
					<source srcset="/88.avif" type="image/avif" />
					<source srcset="/88.webp" type="image/webp" />
					<img src="/88.png" alt="" fetchpriority="high" />
				</picture>
				<div class="duplicate" style={`--current-img: image-set(url('/88.avif') type('image/avif'), url('/88.webp') type('image/webp'), url('/88.png') type('image/png'));`}>
				</div>
			</div>
		</div>
		<nav>
			<Menu client:idle {...{active, currentLang}} />
			<ul>
				<li><a href={translatePath("/stories")} class={trimLocation(active, currentLang).startsWith('/stories') ? "active" : ""}>{t('nav.shortStories')}</a></li>
				<li><a href={translatePath("/lns")} class={trimLocation(active, currentLang).startsWith('/lns') ? "active" : ""}>{t('nav.lightNovels')}</a></li>
				<li><a href={translatePath("/")} class={trimLocation(active, currentLang) == '/' || trimLocation(active, currentLang).startsWith('/anime') ? "active" : ""}>Anime</a></li>
				<li><a href={translatePath("/manga")} class={trimLocation(active, currentLang).startsWith('/manga') ? "active" : ""}>Manga</a></li>
				<li><a href={translatePath("/music")} class={trimLocation(active, currentLang).startsWith('/music') ? "active" : ""}>{t('nav.music')}</a></li>
				<li><a href={translatePath("/downloads")} class={trimLocation(active, currentLang).startsWith('/downloads') ? "active" : ""}>{t('nav.downloads')}</a></li>
			</ul>
			<LanguageSelector {...{currentLang, location: active }} client:idle />
		</nav>
	</div>
</header>
