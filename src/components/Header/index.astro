---
import './styles.scss'
import Menu from '../Menu'

const active = Astro.url.pathname
---
<header>
	<div class="wrapper">
		<div class="rippedWrapper2">
			<div class="ripped2">
				<picture>
					<source srcset="/88.avif" type="image/avif" />
					<source srcset="/88.webp" type="image/webp" />
					<img src="/88.png" alt="" fetchpriority="high" />
				</picture>
				<picture class="duplicate">
					<source srcset="/88.avif" type="image/avif" />
					<source srcset="/88.webp" type="image/webp" />
					<img src="/88.png" alt="" fetchpriority="high" />
				</picture>
			</div>
		</div>
		<nav>
			<Menu client:idle active={active} />
			<ul>
				<li><a href="/stories" class={active.includes('/stories') ? "active" : ""}>Short Stories</a></li>
				<li><a href="/lns" class={active.includes('/lns') ? "active" : ""}>Light Novels</a></li>
				<li><a href="/" class={active == '/' ? "active" : ""}>Home</a></li>
				<li><a href="/anime" class={active.includes('/anime') ? "active" : ""}>Anime</a></li>
				<li><a href="/manga" class={active.includes('/manga') ? "active" : ""}>Manga</a></li>
				<li><a href="/music" class={active == '/music' ? "active" : ""}>Music</a></li>
			</ul>
		</nav>
	</div>
</header>