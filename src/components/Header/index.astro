---
import './styles.scss'
import Menu from '../Menu'

const active = Astro.url.pathname
---
<header>
	<div class="wrapper">
		<div class="rippedWrapper2">
			<div class="ripped2">
				<picture>
					<source srcset="/88.avif" type="image/avif" />
					<source srcset="/88.webp" type="image/webp" />
					<img src="/88.png" alt="" fetchpriority="high" />
				</picture>
				<div class="duplicate" style={`--current-img: image-set(url('/88.avif') type('image/avif'), url('/88.webp') type('image/webp'), url('/88.png') type('image/png'));`}>
				</div>
			</div>
		</div>
		<nav>
			<Menu client:idle active={active} />
			<ul>
				<li><a href="/stories" class={active.startsWith('/stories') ? "active" : ""}>Short Stories</a></li>
				<li><a href="/lns" class={active.startsWith('/lns') ? "active" : ""}>Light Novels</a></li>
				<li><a href="/" class={active == '/' || active.startsWith('/anime') ? "active" : ""}>Anime</a></li>
				<li><a href="/manga" class={active.startsWith('/manga') ? "active" : ""}>Manga</a></li>
				<li><a href="/music" class={active.startsWith('/music') ? "active" : ""}>Music</a></li>
				<li><a href="/downloads" class={active.startsWith('/downloads') ? "active" : ""}>Downloads</a></li>
			</ul>
		</nav>
	</div>
</header>
